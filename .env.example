# URL de producao do site (ex.: https://www.suite360films.com.br), usada em metadata
# (canonical, Open Graph), robots.ts e sitemap.ts. Enquanto vazia ou invalida, o site usa
# http://localhost:3000 com seguranca (nunca quebra) — mas isso NAO deve chegar a producao
# real: configure o dominio definitivo antes do lancamento. Ver PLANEJAMENTO.md, secao 14, item 6.
NEXT_PUBLIC_SITE_URL=

# Numero de WhatsApp Business da Suite360, com codigo do pais e DDD, somente digitos
# (ex.: 5541999999999). Enquanto vazio, todos os CTAs de WhatsApp ficam desabilitados
# de forma segura — nenhum link falso e gerado. Ver PLANEJAMENTO.md, secao 14, item 3.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ID do container do Google Tag Manager (formato GTM-XXXXXXX), publico por natureza.
# Enquanto vazio, nenhum script de analytics carrega e nenhum banner de consentimento
# aparece (o site nao usa nenhum cookie nao essencial sem isso). Quando configurado,
# o banner de consentimento passa a decidir se o GTM realmente carrega (so apos
# "Aceitar"). GA4 deve ser configurado DENTRO do container GTM, nao como uma segunda
# integracao paralela. Ver PLANEJAMENTO.md, secao 14.11.
NEXT_PUBLIC_GTM_ID=
